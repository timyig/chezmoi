[!exec:ansible-playbook] skip 'ansible-playbook not found in $PATH'

exec chezmoi apply
stdout 'Hello from Ansible'

-- home/user/.local/share/chezmoi/run_playbook.yml --
---
- name: Test playbook
  hosts: localhost
  connection: local
  gather_facts: false
  tasks:
    - name: Print message
      ansible.builtin.debug:
        msg: "Hello from Ansible"
